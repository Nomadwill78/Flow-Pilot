# ─── LLM provider ────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works: Anthropic, OpenAI, Google, Groq,
# Together, OpenRouter, Alibaba DashScope, or a local model via Ollama/vLLM.
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=claude-sonnet-5
# "anthropic" for the Anthropic Messages API, "openai" for anything
# OpenAI-compatible (including DashScope, Groq, Ollama, vLLM).
LLM_PROTOCOL=anthropic

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production

# Comma-separated list of origins allowed to call this proxy.
# Set this. A wildcard here means anyone can spend your API budget.
ALLOWED_ORIGINS=http://localhost:3000,https://app.yourcustomer.com

# ─── Auth ────────────────────────────────────────────────────────────────────
# Your app mints a short-lived JWT per signed-in user and passes it to the
# widget as `token`. This proxy verifies it. Leave AUTH_MODE=none only for
# local development.
AUTH_MODE=jwt
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=your-app

# ─── Rate limiting (per user, in-memory) ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_PAGE_CHARS=12000
MAX_TOKENS=1024
